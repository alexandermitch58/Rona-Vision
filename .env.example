# Rona Vision — Mock Mode (tanpa API key, tanpa biaya)
# Salin nilai ini ke Cloudflare Pages > rona-vision > Settings > Environment variables.
# JANGAN commit file berisi key asli ke repo.

# Mode mock AKTIF: backend tidak memanggil fal.ai, job selesai ~20 detik
# dengan video contoh. Wajib "true" untuk paket mock ini.
MOCK_MODE=true

# Kosongkan / jangan isi untuk mock. Baru diisi saat beralih ke video asli:
# FAL_KEY=

# Opsional, dipakai saat submit ke fal (mode nyata saja)
FAL_WEBHOOK_URL=https://rona-vision.pages.dev/api/webhooks/fal

# Untuk model Muse asli (bukan mock): secret acak panjang untuk
# GET /api/muse-queue dan POST /api/muse-jobs/:id/complete.
# Model Muse tidak butuh FAL_KEY.
MUSE_WORKER_SECRET=isi-dengan-string-acak-panjang

# Penyimpanan server (bukan environment variable, tapi BINDING di
# Cloudflare Pages > Settings > Functions):
# - KV namespace, nama variabel: RONA_KV (wajib — job, kredit, metadata upload)
# - R2 bucket, nama variabel: RONA_R2 (wajib untuk produksi — foto referensi
#   dan video final; tanpa ini, foto <= 1 MB saja yang bisa disimpan di KV
#   sebagai fallback, dan video final tetap memakai URL provider sementara)
